--==================================================
-- AUTO STEAL BUTTON
--==================================================

autoButton.Activated:Connect(function()

    autoLeft = not autoLeft

    if autoLeft then

        autoButton.Text = "AUTO STEAL: ON"
        autoButton.BackgroundColor3 = Color3.fromRGB(38, 90, 52)

        configurarTodosPrompts()

        -- Novos prompts recebem HoldDuration = 0
        autoStealConnection = game.DescendantAdded:Connect(function(object)

            if not autoLeft then
                return
            end

            if object:IsA("ProximityPrompt") then
                configurarPrompt(object)
            end

        end)

        -- Só executa quando o Roblox mostra
        -- o prompt por ele estar no alcance.
        promptCheckConnection =
            ProximityPromptService.PromptShown:Connect(function(prompt)

                if not autoLeft then
                    return
                end

                if not prompt or not prompt:IsA("ProximityPrompt") then
                    return
                end

                if not prompt.Enabled then
                    return
                end

                -- Remove qualquer tempo de espera
                prompt.HoldDuration = 0

                task.defer(function()

                    if not autoLeft then
                        return
                    end

                    if not prompt.Parent then
                        return
                    end

                    if not prompt.Enabled then
                        return
                    end

                    if typeof(fireproximityprompt) == "function" then

                        pcall(function()
                            fireproximityprompt(prompt, 1, true)
                        end)

                    end

                end)

            end)

    else

        autoButton.Text = "AUTO STEAL: OFF"
        autoButton.BackgroundColor3 = Color3.fromRGB(30, 30, 35)

        pararAutoSteal()

    end

end)

--==================================================
-- RESPAWN
--==================================================

player.CharacterAdded:Connect(function(character)

    movimentoToken += 1

    liberarControles()
    removerOrientacao()

    ativo = false

    atualizarUI(true)

    task.wait(1)

    if not character.Parent then
        return
    end

    if autoLeft then
        configurarTodosPrompts()
    end

end)

