--==================================================
-- TIRAR DELAY + ULTRA OTIMIZAÇÃO
-- CLIENT-SIDE / MOBILE
--==================================================

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local UserInputService = game:GetService("UserInputService")

local Player = Players.LocalPlayer

--==================================================
-- CONFIG
--==================================================

local Enabled = false

--==================================================
-- GUI
--==================================================

local Gui = Instance.new("ScreenGui")
Gui.Name = "UltraOptimizer"
Gui.ResetOnSpawn = false
Gui.IgnoreGuiInset = true
Gui.Parent = Player:WaitForChild("PlayerGui")

local Button = Instance.new("TextButton")
Button.Name = "TirarDelay"
Button.Size = UDim2.fromOffset(165, 48)
Button.Position = UDim2.new(0.5, -82, 0.5, -24)

Button.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
Button.BorderSizePixel = 0

Button.Text = "TIRAR DELAY: OFF"
Button.TextColor3 = Color3.new(1, 1, 1)
Button.TextSize = 14
Button.Font = Enum.Font.GothamBold

Button.Parent = Gui

local Corner = Instance.new("UICorner")
Corner.CornerRadius = UDim.new(0, 12)
Corner.Parent = Button

local Stroke = Instance.new("UIStroke")
Stroke.Color = Color3.fromRGB(55, 55, 55)
Stroke.Thickness = 1
Stroke.Parent = Button

--==================================================
-- DRAG
--==================================================

local Dragging = false
local DragStart
local StartPosition

Button.InputBegan:Connect(function(Input)

    if Input.UserInputType == Enum.UserInputType.Touch
        or Input.UserInputType == Enum.UserInputType.MouseButton1 then

        Dragging = true
        DragStart = Input.Position
        StartPosition = Button.Position
    end
end)

Button.InputEnded:Connect(function(Input)

    if Input.UserInputType == Enum.UserInputType.Touch
        or Input.UserInputType == Enum.UserInputType.MouseButton1 then

        Dragging = false
    end
end)

UserInputService.InputChanged:Connect(function(Input)

    if not Dragging then
        return
    end

    if Input.UserInputType == Enum.UserInputType.Touch
        or Input.UserInputType == Enum.UserInputType.MouseMovement then

        local Delta =
            Input.Position - DragStart

        Button.Position = UDim2.new(
            StartPosition.X.Scale,
            StartPosition.X.Offset + Delta.X,

            StartPosition.Y.Scale,
            StartPosition.Y.Offset + Delta.Y
        )
    end
end)

--==================================================
-- PROMPTS
--==================================================

local Prompts = {}

local function SetPrompt(Prompt)

    if not Prompt:IsA("ProximityPrompt") then
        return
    end

    Prompts[Prompt] = true

    if Enabled then

        pcall(function()
            Prompt.HoldDuration = 0
        end)
    end
end

local function RemovePrompt(Object)

    Prompts[Object] = nil
end

--==================================================
-- REGISTRAR PROMPTS EXISTENTES
--==================================================

for _, Object in ipairs(workspace:GetDescendants()) do

    if Object:IsA("ProximityPrompt") then
        SetPrompt(Object)
    end
end

--==================================================
-- NOVOS PROMPTS / OBJETOS
--==================================================

workspace.DescendantAdded:Connect(function(Object)

    if Object:IsA("ProximityPrompt") then
        SetPrompt(Object)
    end
end)

workspace.DescendantRemoving:Connect(function(Object)

    if Object:IsA("ProximityPrompt") then
        RemovePrompt(Object)
    end
end)

--==================================================
-- ESTADOS PARA RESTAURAR
--==================================================

local DisabledObjects = {}

local OldGlobalShadows = Lighting.GlobalShadows
local OldDiffuse = Lighting.EnvironmentDiffuseScale
local OldSpecular = Lighting.EnvironmentSpecularScale

--==================================================
-- OTIMIZAÇÃO INDIVIDUAL
--==================================================

local function Disable(Object)

    if not Object.Enabled then
        return
    end

    DisabledObjects[Object] = true

    pcall(function()
        Object.Enabled = false
    end)
end

local function Optimize(Object)

    if Object:IsA("ParticleEmitter") then

        Disable(Object)
        return
    end

    if Object:IsA("Trail") then

        Disable(Object)
        return
    end

    if Object:IsA("Beam") then

        Disable(Object)
        return
    end

    if Object:IsA("Smoke") then

        Disable(Object)
        return
    end

    if Object:IsA("Fire") then

        Disable(Object)
        return
    end

    if Object:IsA("Sparkles") then

        Disable(Object)
        return
    end

    if Object:IsA("PointLight")
        or Object:IsA("SpotLight")
        or Object:IsA("SurfaceLight") then

        Disable(Object)
        return
    end

    if Object:IsA("BloomEffect")
        or Object:IsA("BlurEffect")
        or Object:IsA("ColorCorrectionEffect")
        or Object:IsA("DepthOfFieldEffect")
        or Object:IsA("SunRaysEffect") then

        Disable(Object)
        return
    end
end

--==================================================
-- ULTRA OTIMIZAÇÃO
--==================================================

local function OptimizeGame()

    if not Enabled then
        return
    end

    -- Uma única varredura.
    local Objects =
        game:GetDescendants()

    for i = 1, #Objects do

        if not Enabled then
            return
        end

        Optimize(Objects[i])

        -- Divide a tarefa em pequenos lotes.
        -- Isso evita congelar o celular.
        if i % 150 == 0 then
            task.wait()
        end
    end

    if not Enabled then
        return
    end

    --==================================================
    -- LIGHTING
    --==================================================

    pcall(function()
        Lighting.GlobalShadows = false
    end)

    pcall(function()
        Lighting.EnvironmentDiffuseScale = 0
    end)

    pcall(function()
        Lighting.EnvironmentSpecularScale = 0
    end)
end

--==================================================
-- OTIMIZAR SOMENTE OBJETOS NOVOS
--==================================================

game.DescendantAdded:Connect(function(Object)

    if not Enabled then
        return
    end

    -- Não faz nova varredura.
    -- Só verifica o objeto que acabou de aparecer.
    task.defer(function()

        if Enabled and Object.Parent then
            Optimize(Object)
        end
    end)
end)

--==================================================
-- ATIVAR DELAY ZERO
--==================================================

local function Enable()

    if Enabled then
        return
    end

    Enabled = true

    Button.Text =
        "TIRAR DELAY: ON"

    -- Prompts atuais
    for Prompt in pairs(Prompts) do

        if Prompt and Prompt.Parent then

            pcall(function()
                Prompt.HoldDuration = 0
            end)
        end
    end

    -- Otimização pesada apenas uma vez.
    task.spawn(OptimizeGame)
end

--==================================================
-- DESATIVAR
--==================================================

local function DisableOptimization()

    Enabled = false

    Button.Text =
        "TIRAR DELAY: OFF"

    -- Restaurar efeitos
    for Object in pairs(DisabledObjects) do

        if Object and Object.Parent then

            pcall(function()
                Object.Enabled = true
            end)
        end
    end

    table.clear(DisabledObjects)

    pcall(function()
        Lighting.GlobalShadows =
            OldGlobalShadows
    end)

    pcall(function()
        Lighting.EnvironmentDiffuseScale =
            OldDiffuse
    end)

    pcall(function()
        Lighting.EnvironmentSpecularScale =
            OldSpecular
    end)
end

--==================================================
-- BOTÃO
--==================================================

Button.Activated:Connect(function()

    if Enabled then
        DisableOptimization()
    else
        Enable()
    end
end)

--==================================================
-- RESPAWN
--==================================================

Player.CharacterAdded:Connect(function(Character)

    if not Enabled then
        return
    end

    -- Só otimiza o personagem novo.
    task.defer(function()

        for _, Object in ipairs(Character:GetDescendants()) do

            if not Enabled then
                return
            end

            Optimize(Object)
        end
    end)
end)
