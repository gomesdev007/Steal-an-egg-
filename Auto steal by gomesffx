--==================================================
-- TESTE
--==================================================

local function EnableTest()

    TestEnabled = true

    TestButton.Text =
        "TESTE: ON"

    for Prompt in pairs(Prompts) do

        if Prompt and Prompt.Parent then

            if OriginalHoldDuration[Prompt] == nil then

                OriginalHoldDuration[Prompt] =
                    Prompt.HoldDuration
            end

            pcall(function()
                Prompt.HoldDuration = 0
            end)
        end
    end

    task.spawn(function()
        OptimizeClient()
    end)
end

local function DisableTest()

    TestEnabled = false

    TestButton.Text =
        "TESTE: OFF"

    DestroyCircle()

    for Prompt, Original in pairs(OriginalHoldDuration) do

        if Prompt and Prompt.Parent then

            pcall(function()
                Prompt.HoldDuration = Original
            end)
        end
    end

    RestoreClient()
end

TestButton.Activated:Connect(function()

    if TestEnabled then
        DisableTest()
    else
        EnableTest()
    end
end)

