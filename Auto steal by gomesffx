--==================================================
-- PROMPTS
--==================================================

local Prompts = {}
local OriginalHoldDuration = {}

local function RegisterPrompt(Object)

    if not Object:IsA("ProximityPrompt") then
        return
    end

    Prompts[Object] = true

    if OriginalHoldDuration[Object] == nil then

        OriginalHoldDuration[Object] =
            Object.HoldDuration
    end

    if TestEnabled then

        pcall(function()
            Object.HoldDuration = 0
        end)
    end
end

local function UnregisterPrompt(Object)

    Prompts[Object] = nil
    OriginalHoldDuration[Object] = nil
end

-- Registro inicial
for _, Object in ipairs(workspace:GetDescendants()) do

    if Object:IsA("ProximityPrompt") then
        RegisterPrompt(Object)
    end
end

workspace.DescendantAdded:Connect(function(Object)

    if Object:IsA("ProximityPrompt") then
        RegisterPrompt(Object)
    end
end)

workspace.DescendantRemoving:Connect(function(Object)

    if Object:IsA("ProximityPrompt") then
        UnregisterPrompt(Object)
    end
end)

--==================================================
-- CÍRCULO
--==================================================

local CircleFolder = Instance.new("Folder")
CircleFolder.Name = "TesteCircle"
CircleFolder.Parent = workspace

local CircleParts = {}
local CurrentRadius = 0

local function DestroyCircle()

    for _, Part in ipairs(CircleParts) do

        if Part and Part.Parent then
            Part:Destroy()
        end
    end

    table.clear(CircleParts)
    CurrentRadius = 0
end

local function CreateCircle(Radius)

    DestroyCircle()

    CurrentRadius = Radius

    local Length =
        (2 * math.pi * Radius) / CIRCLE_SEGMENTS

    for i = 1, CIRCLE_SEGMENTS do

        local Part = Instance.new("Part")

        Part.Name = "CircleSegment"

        Part.Anchored = true

        Part.CanCollide = false
        Part.CanTouch = false
        Part.CanQuery = false

        Part.CastShadow = false

        Part.Material = Enum.Material.Neon
        Part.Color = Color3.fromRGB(255, 255, 255)

        Part.Transparency = 0.15

        Part.Size = Vector3.new(
            Length + 0.04,
            CIRCLE_HEIGHT,
            CIRCLE_THICKNESS
        )

        Part.Parent = CircleFolder

        CircleParts[i] = Part
    end
end

local function UpdateCircle(Position, Radius)

    if #CircleParts ~= CIRCLE_SEGMENTS
        or math.abs(CurrentRadius - Radius) > 0.5 then

        CreateCircle(Radius)
    end

    local Length =
        (2 * math.pi * Radius) / CIRCLE_SEGMENTS

    for i, Part in ipairs(CircleParts) do

        if not Part.Parent then
            return
        end

        local A1 =
            ((i - 1) / CIRCLE_SEGMENTS) * math.pi * 2

        local A2 =
            (i / CIRCLE_SEGMENTS) * math.pi * 2

        local P1 = Vector3.new(
            Position.X + math.cos(A1) * Radius,
            Position.Y,
            Position.Z + math.sin(A1) * Radius
        )

        local P2 = Vector3.new(
            Position.X + math.cos(A2) * Radius,
            Position.Y,
            Position.Z + math.sin(A2) * Radius
        )

        Part.Size = Vector3.new(
            Length + 0.04,
            CIRCLE_HEIGHT,
            CIRCLE_THICKNESS
        )

        Part.CFrame =
            CFrame.lookAt(
                (P1 + P2) / 2,
                P2
            )
            * CFrame.Angles(0, math.pi / 2, 0)
    end
end

--==================================================
-- POSIÇÃO DO PROMPT
--==================================================

local function GetPromptPosition(Prompt)

    local Parent = Prompt.Parent

    if not Parent then
        return nil
    end

    if Parent:IsA("Attachment") then
        return Parent.WorldPosition
    end

    if Parent:IsA("BasePart") then
        return Parent.Position
    end

    return nil
end

--==================================================
-- OTIMIZAÇÃO VISUAL LOCAL
--==================================================

local Optimization = {
    Enabled = {},
    GlobalShadows = nil
}

local function OptimizeObject(Object)

    if Object:IsA("ParticleEmitter")
        or Object:IsA("Trail")
        or Object:IsA("Beam")
        or Object:IsA("Smoke")
        or Object:IsA("Fire")
        or Object:IsA("Sparkles")
        or Object:IsA("PointLight")
        or Object:IsA("SpotLight")
        or Object:IsA("SurfaceLight")
        or Object:IsA("BloomEffect")
        or Object:IsA("BlurEffect")
        or Object:IsA("ColorCorrectionEffect")
        or Object:IsA("DepthOfFieldEffect")
        or Object:IsA("SunRaysEffect") then

        if Optimization.Enabled[Object] == nil then

            Optimization.Enabled[Object] =
                Object.Enabled
        end

        Object.Enabled = false
    end
end

local function OptimizeClient()

    for _, Object in ipairs(game:GetDescendants()) do

        if not TestEnabled then
            break
        end

        pcall(function()
            OptimizeObject(Object)
        end)
    end

    if TestEnabled then

        if Optimization.GlobalShadows == nil then

            Optimization.GlobalShadows =
                Lighting.GlobalShadows
        end

        pcall(function()
            Lighting.GlobalShadows = false
        end)
    end
end

local function RestoreClient()

    for Object, Value in pairs(Optimization.Enabled) do

        if Object and Object.Parent then

            pcall(function()
                Object.Enabled = Value
            end)
        end
    end

    table.clear(Optimization.Enabled)

    if Optimization.GlobalShadows ~= nil then

        pcall(function()
            Lighting.GlobalShadows =
                Optimization.GlobalShadows
        end)

        Optimization.GlobalShadows = nil
    end
end

--==================================================
-- PROMPT MAIS PRÓXIMO
--==================================================

local function GetNearestPrompt()

    local CurrentCharacter =
        LocalPlayer.Character

    if not CurrentCharacter then
        return nil
    end

    local CurrentRoot =
        CurrentCharacter:FindFirstChild(
            "HumanoidRootPart"
        )

    if not CurrentRoot then
        return nil
    end

    local Nearest = nil
    local NearestDistance = math.huge

    for Prompt in pairs(Prompts) do

        if Prompt
            and Prompt.Parent
            and Prompt.Enabled then

            local Position =
                GetPromptPosition(Prompt)

            if Position then

                local Distance =
                    (CurrentRoot.Position - Position).Magnitude

                if Distance < NearestDistance then

                    NearestDistance = Distance
                    Nearest = Prompt
                end
            end
        end
    end

    return Nearest
end

--==================================================
-- MOVIMENTO
--==================================================

local GoingToPrompt = false

local MovementConnection = nil
local InputConnections = {}

local MovementToken = 0

local function DisconnectMovementInputs()

    for _, Connection in ipairs(InputConnections) do

        if Connection then
            Connection:Disconnect()
        end
    end

    table.clear(InputConnections)
end

local function StopMovement()

    MovementToken += 1

    GoingToPrompt = false

    if MovementConnection then

        MovementConnection:Disconnect()
        MovementConnection = nil
    end

    DisconnectMovementInputs()

    local CurrentCharacter =
        LocalPlayer.Character

    if CurrentCharacter then

        local CurrentHumanoid =
            CurrentCharacter:FindFirstChildOfClass(
                "Humanoid"
            )

        local CurrentRoot =
            CurrentCharacter:FindFirstChild(
                "HumanoidRootPart"
            )

        if CurrentHumanoid
            and CurrentRoot then

            pcall(function()
                CurrentHumanoid:Move(
                    Vector3.zero,
                    false
                )
            end)
        end
    end

    NearButton.Text =
        "IR ATÉ O MAIS PERTO"
end

local function FinishMovement()

    GoingToPrompt = false

    if MovementConnection then

        MovementConnection:Disconnect()
        MovementConnection = nil
    end

    DisconnectMovementInputs()

    NearButton.Text =
        "IR ATÉ O MAIS PERTO"
end

local function StartMovement(Prompt)

    if GoingToPrompt then
        return
    end

    local TargetPosition =
        GetPromptPosition(Prompt)

    if not TargetPosition then
        return
    end

    local CurrentCharacter =
        LocalPlayer.Character

    if not CurrentCharacter then
        return
    end

    local CurrentHumanoid =
        CurrentCharacter:FindFirstChildOfClass(
            "Humanoid"
        )

    local CurrentRoot =
        CurrentCharacter:FindFirstChild(
            "HumanoidRootPart"
        )

    if not CurrentHumanoid
        or not CurrentRoot then
        return
    end

    GoingToPrompt = true

    MovementToken += 1

    local MyToken = MovementToken

    NearButton.Text = "INDO..."

    local StartTime = os.clock()

    --==================================================
    -- INTERFERÊNCIA DE TECLADO
    --==================================================

    table.insert(
        InputConnections,

        UserInputService.InputBegan:Connect(
            function(Input, GameProcessed)

                if not GoingToPrompt
                    or MyToken ~= MovementToken then
                    return
                end

                if GameProcessed then
                    return
                end

                if Input.KeyCode == Enum.KeyCode.W
                    or Input.KeyCode == Enum.KeyCode.A
                    or Input.KeyCode == Enum.KeyCode.S
                    or Input.KeyCode == Enum.KeyCode.D
                    or Input.KeyCode == Enum.KeyCode.Space then

                    StopMovement()
                end
            end
        )
    )

    --==================================================
    -- GAMEPAD
    --==================================================

    table.insert(
        InputConnections,

        UserInputService.InputChanged:Connect(
            function(Input)

                if not GoingToPrompt
                    or MyToken ~= MovementToken then
                    return
                end

                if Input.UserInputType ==
                    Enum.UserInputType.Gamepad1 then

                    if Input.KeyCode ==
                        Enum.KeyCode.Thumbstick1 then

                        local Position =
                            Input.Position

                        if math.abs(Position.X) > 0.15
                            or math.abs(Position.Y) > 0.15 then

                            StopMovement()
                        end
                    end
                end
            end
        )
    )

    --==================================================
    -- TOUCH
    --==================================================

    table.insert(
        InputConnections,

        UserInputService.TouchPan:Connect(
            function(
                TouchPositions,
                TotalTranslation,
                Velocity,
                State
            )

                if not GoingToPrompt
                    or MyToken ~= MovementToken then
                    return
                end

                if State ==
                    Enum.UserInputState.Change then

                    if TotalTranslation.Magnitude > 3 then

                        StopMovement()
                    end
                end
            end
        )
    )

    --==================================================
    -- COMEÇA A ANDAR
    --==================================================

    pcall(function()
        CurrentHumanoid:MoveTo(
            TargetPosition
        )
    end)

    --==================================================
    -- MONITORAMENTO
    --==================================================

    MovementConnection =
        RunService.Heartbeat:Connect(function()

            if not GoingToPrompt then
                return
            end

            if MyToken ~= MovementToken then
                return
            end

            -- Pega o personagem ATUAL.
            local NewCharacter =
                LocalPlayer.Character

            if not NewCharacter then

                StopMovement()
                return
            end

            local NewHumanoid =
                NewCharacter:FindFirstChildOfClass(
                    "Humanoid"
                )

            local NewRoot =
                NewCharacter:FindFirstChild(
                    "HumanoidRootPart"
                )

            -- Resetou / personagem mudou
            if NewCharacter ~= CurrentCharacter then

                StopMovement()
                return
            end

            if not NewHumanoid
                or not NewRoot then

                StopMovement()
                return
            end

            if not Prompt.Parent then

                StopMovement()
                return
            end

            local Distance =
                (NewRoot.Position - TargetPosition).Magnitude

            if Distance <= 3 then

                FinishMovement()
                return
            end

            if os.clock() - StartTime >= 10 then

                StopMovement()
                return
            end
        end)
end

