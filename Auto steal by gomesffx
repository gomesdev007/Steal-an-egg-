    end)
end)

--==================================================
-- LOOP DO TESTE
--==================================================

 local Timer = 0

RunService.Heartbeat:Connect(function(DeltaTime)

    if not TestEnabled then
        return
    end

    Timer += DeltaTime

    if Timer < PROMPT_INTERVAL then
        return
    end

    Timer = 0

    -- Sempre procura o personagem atual.
    local CurrentCharacter =
        LocalPlayer.Character

    if not CurrentCharacter then
        return
    end

    local CurrentRoot =
        CurrentCharacter:FindFirstChild(
            "HumanoidRootPart"
        )

    if not CurrentRoot then
        return
    end

    local NearestPrompt =
        GetNearestPrompt()

    local Radius =
        DEFAULT_RADIUS

    if NearestPrompt then

        Radius =
            NearestPrompt.MaxActivationDistance
    end

    local CirclePosition =
        Vector3.new(
            CurrentRoot.Position.X,
            CurrentRoot.Position.Y - 2.8,
            CurrentRoot.Position.Z
        )

    UpdateCircle(
        CirclePosition,
        Radius
    )
end)

--==================================================
-- RESPAWN / CHARACTER ADDED
--==================================================

LocalPlayer.CharacterAdded:Connect(function(NewCharacter)

    -- Cancela somente o movimento atual.
    -- NÃO desliga o TESTE.
    if GoingToPrompt then
        StopMovement()
    end

    -- Atualiza referências para o personagem novo.
    UpdateCharacter(NewCharacter)

    task.wait(1)

    if TestEnabled then

        -- Reaplica HoldDuration = 0
        for Prompt in pairs(Prompts) do

            if Prompt and Prompt.Parent then

                pcall(function()
                    Prompt.HoldDuration = 0
                end)
            end
        end

        -- Recria o círculo
        if #CircleParts == 0 then
            CreateCircle(DEFAULT_RADIUS)
        end

        -- Reaplica otimização nos efeitos existentes
        task.spawn(function()

            if TestEnabled then
                OptimizeClient()
            end
        end)
    end
end)

--==================================================
-- CHARACTER REMOVING
--==================================================

LocalPlayer.CharacterRemoving:Connect(function()

    -- Não desliga o TESTE.
    -- Apenas invalida o movimento atual.

    if GoingToPrompt then
        StopMovement()
    end

    Character = nil
    Humanoid = nil
    Root = nil
end)
