-- CHARACTER
--==================================================

local Character
local Humanoid
local RootPart

local function updateCharacter()

    Character =
        Player.Character
        or Player.CharacterAdded:Wait()

    Humanoid =
        Character:WaitForChild("Humanoid")

    RootPart =
        Character:WaitForChild(
            "HumanoidRootPart"
        )

end

updateCharacter()

Player.CharacterAdded:Connect(
    function()

        task.wait(1)

        updateCharacter()

    end
)

--==================================================
-- PROMPTS
--==================================================

local function getPromptPart(prompt)

    if not prompt
        or not prompt.Parent then
        return nil
    end

    if prompt.Parent:IsA("BasePart") then
        return prompt.Parent
    end

    return prompt.Parent:
        FindFirstChildWhichIsA(
            "BasePart",
            true
        )

end

local function activatePrompt(prompt)

    if not prompt then
        return false
    end

    if not prompt.Parent then
        return false
    end

    if not prompt:IsA(
        "ProximityPrompt"
    ) then
        return false
    end

    if not prompt.Enabled then
        return false
    end

    if typeof(
        fireproximityprompt
    ) == "function" then

        local success =
            pcall(function()

                fireproximityprompt(
                    prompt
                )

            end)

        return success
    end

    return false

end

--==================================================
-- PROMPT DO OVO
--==================================================

local function getEggPrompt(egg)

    if not egg
        or not egg.Parent then
        return nil
    end

    local eggPart =
        getTargetPart(egg)

    if not eggPart then
        return nil
    end

    local closest
    local closestDistance =
        math.huge

    for _, obj in ipairs(
        egg:GetDescendants()
    ) do

        if obj:IsA(
            "ProximityPrompt"
        )
        and obj.Enabled then

            local part =
                getPromptPart(obj)

            if part then

                local distance =
                    (
                        part.Position
                        - eggPart.Position
                    ).Magnitude

                if distance <
                    closestDistance then

                    closestDistance =
                        distance

                    closest = obj

                end

            end

        end

    end

    return closest

end

--==================================================
-- PROMPT PERTO DA POSIÇÃO
--==================================================

local function getPromptNearPosition(
    position,
    radius
)

    local closest
    local closestDistance = radius

    for _, obj in ipairs(
        workspace:GetDescendants()
    ) do

        if obj:IsA(
            "ProximityPrompt"
        )
        and obj.Enabled then

            local part =
                getPromptPart(obj)

            if part then

                local distance =
                    (
                        part.Position
                        - position
                    ).Magnitude

                if distance <=
                    closestDistance then

                    closestDistance =
                        distance

                    closest = obj

                end

            end

        end

    end

    return closest

end

--==================================================
-- OVO USADO
--==================================================

local UsedEggs = {}

--==================================================
-- OVO MAIS PRÓXIMO
--==================================================

local function getNearestEgg()

    if not RootPart then
        return nil
    end

    local nearest
    local nearestDistance =
        math.huge

    for egg, billboard in pairs(ESPs) do

        if egg
            and egg.Parent
            and billboard
            and billboard.Parent
            and not UsedEggs[egg] then

            local target =
                getTargetPart(egg)

            if target then

                local distance =
                    (
                        target.Position
                        - RootPart.Position
                    ).Magnitude

                if distance <
                    nearestDistance then

                    nearestDistance =
                        distance

                    nearest = egg

                end

            end

        end

    end

    return nearest

end

--==================================================
-- DETECTAR INTERRUPÇÃO
--==================================================

local function wasInterrupted()

    if not farmEnabled then
        return true
    end

    if not Character
        or not Character.Parent then
        return true
    end

    if not Humanoid
        or Humanoid.Health <= 0 then
        return true
    end

    local state =
        Humanoid:GetState()

    if state ==
        Enum.HumanoidStateType.Ragdoll
        or state ==
        Enum.HumanoidStateType.FallingDown
        or state ==
        Enum.HumanoidStateType.Physics
        or state ==
        Enum.HumanoidStateType.PlatformStanding
        or state ==
        Enum.HumanoidStateType.Seated
        or state ==
        Enum.HumanoidStateType.Dead then

        return true

    end

    return false

end

--==================================================
-- ANDAR
--==================================================

local function walkTo(
    position,
    distance
)

    if not Humanoid
        or not RootPart then
        return false
    end

    Humanoid.WalkSpeed =
        FARM_SPEED

    local lastMove = 0

    while farmEnabled do

        if wasInterrupted() then
            return false
        end

        local currentDistance =
            (
                RootPart.Position
                - position
            ).Magnitude

        if currentDistance <=
            distance then

            Humanoid:MoveTo(
                RootPart.Position
            )

            return true

        end

        if tick() - lastMove >=
            0.3 then

            Humanoid:MoveTo(
                position
            )

            lastMove = tick()

        end

        task.wait(0.05)

    end

    return false

end

--==================================================
-- IR ATÉ OVO
--==================================================

local function walkToEgg(egg)

    if not egg
        or not egg.Parent then
        return false
    end

    Humanoid.WalkSpeed =
        FARM_SPEED

    local lastMove = 0

    while farmEnabled do

        if wasInterrupted() then
            return false
        end

        if not egg.Parent then
            return false
        end

        local target =
            getTargetPart(egg)

        if not target then
            return false
        end

        local targetPosition =
            target.Position
            + Vector3.new(0, 1.5, 0)

        local distance =
            (
                RootPart.Position
                - targetPosition
            ).Magnitude

        --==========================================
        -- CONFIRMOU PRESENÇA NO OVO
        --==========================================

        if distance <=
            EGG_DISTANCE then

            Humanoid:MoveTo(
                RootPart.Position
            )

            task.wait(0.15)

            -- SOMENTE AGORA procura prompt
            local prompt =
                getEggPrompt(egg)

            if prompt then

                local activated =
                    activatePrompt(prompt)

                if activated then

                    -- Marca imediatamente
                    UsedEggs[egg] = true

                    -- Sai imediatamente do ovo
                    -- e vai para POS1
                    return true

                end

            end

        else

            -- Enquanto está andando:
            -- NÃO ativa prompts.

            if tick() - lastMove >=
                0.3 then

                Humanoid:MoveTo(
                    targetPosition
                )

                lastMove = tick()

            end

        end

        task.wait(0.05)

    end

    return false

end

--==================================================
-- AUTO PROMPT NA POSIÇÃO
--==================================================

local function activateAtPosition(
    position
)

    if not RootPart then
        return false
    end

    -- Confirma presença primeiro
    local distance =
        (
            RootPart.Position
            - position
        ).Magnitude

    if distance >
        PROMPT_RADIUS then

        return false

    end

    -- Agora procura o prompt
    local prompt =
        getPromptNearPosition(
            position,
            PROMPT_RADIUS
        )

    if prompt then

        return activatePrompt(
            prompt
        )

    end

    return false

end

--==================================================
-- CICLO
--==================================================

local function runCycle()

    --==============================================
    -- 1. NOVO OVO
    --==============================================

    local egg =
        getNearestEgg()

    if not egg then
        return false
    end

    --==============================================
    -- 2. OVO
    --==============================================

    local eggFinished =
        walkToEgg(egg)

    if not eggFinished then
        return false
    end

    if not farmEnabled then
        return false
    end

    --==============================================
    -- 3. DIRETO PARA POS1
    --==============================================

    local pos1Reached =
        walkTo(
            POS1,
            POS1_DISTANCE
        )

    if not pos1Reached then
        return false
    end

    if not farmEnabled then
        return false
    end

    --==============================================
    -- 4. CONFIRMOU POS1
    -- AUTO PROMPT LIGA AQUI
    --==============================================

    Humanoid:MoveTo(
        RootPart.Position
    )

    task.wait(0.1)

    activateAtPosition(POS1)

    --==============================================
    -- 5. TRAVA 1 SEGUNDO
    --==============================================

    Humanoid:MoveTo(
        RootPart.Position
    )

    task.wait(1)

    if not farmEnabled then
        return false
    end

    --==============================================
    -- 6. POS2
    --==============================================

    local pos2Reached =
        walkTo(
            POS2,
            POS2_DISTANCE
        )

    if not pos2Reached then
        return false
    end

    if not farmEnabled then
        return false
    end

    --==============================================
    -- 7. CONFIRMOU POS2
    -- PROMPT
    --==============================================

    Humanoid:MoveTo(
        RootPart.Position
    )

    task.wait(0.1)

    activateAtPosition(POS2)

    task.wait(0.4)

    --==============================================
    -- 8. CICLO COMPLETO
    --==============================================

    return true

end

--==================================================
-- FARM LOOP
--==================================================

local function startFarm()

    if farmRunning then
        return
    end

    farmRunning = true

    task.spawn(function()

        while farmEnabled do

            if not Character
                or not Character.Parent
                or not Humanoid
                or not RootPart then

                updateCharacter()

                task.wait(0.5)

            else

                local success =
                    runCycle()

                if not farmEnabled then
                    break
                end

                -- Se foi interrompido:
                -- PARA e começa novamente do zero.
                if not success then

                    Humanoid:MoveTo(
                        RootPart.Position
                    )

                    task.wait(0.3)

                else

                    -- Só depois de POS2
                    -- procura outro ovo.
                    task.wait(0.2)

                end

            end

        end

        farmRunning = false

    end)

end

