--// TIRAR DELAY
--// LocalScript
--// StarterPlayer > StarterPlayerScripts

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Player = Players.LocalPlayer

--==================================================
-- CONFIG
--==================================================

local RADIUS = 200
local RADIUS_SQUARED = RADIUS * RADIUS

-- Intervalo da verificação.
-- Não usa Heartbeat para evitar peso desnecessário.
local CHECK_INTERVAL = 0.15

local Enabled = false

-- Guarda o HoldDuration original de cada prompt
local OriginalDuration = {}

--==================================================
-- GUI
--==================================================

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "TirarDelayUI"
ScreenGui.ResetOnSpawn = false
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
ScreenGui.Parent = Player:WaitForChild("PlayerGui")

local Button = Instance.new("TextButton")
Button.Name = "TirarDelay"
Button.Size = UDim2.fromOffset(125, 38)
Button.Position = UDim2.new(0, 20, 0.5, -19)

Button.BackgroundColor3 = Color3.fromRGB(12, 12, 12)
Button.BorderSizePixel = 0

Button.Text = "TIRAR DELAY"
Button.TextColor3 = Color3.fromRGB(255, 255, 255)
Button.TextSize = 13
Button.Font = Enum.Font.GothamBold

Button.AutoButtonColor = false
Button.Parent = ScreenGui

local Corner = Instance.new("UICorner")
Corner.CornerRadius = UDim.new(0, 10)
Corner.Parent = Button

local Stroke = Instance.new("UIStroke")
Stroke.Color = Color3.fromRGB(45, 45, 45)
Stroke.Thickness = 1
Stroke.Parent = Button

--==================================================
-- ARRASTAR
--==================================================

local Dragging = false
local DragStart
local StartPosition

Button.InputBegan:Connect(function(Input)

	if Input.UserInputType == Enum.UserInputType.MouseButton1
		or Input.UserInputType == Enum.UserInputType.Touch then

		Dragging = true
		DragStart = Input.Position
		StartPosition = Button.Position

	end

end)

UserInputService.InputChanged:Connect(function(Input)

	if not Dragging then
		return
	end

	if Input.UserInputType == Enum.UserInputType.MouseMovement
		or Input.UserInputType == Enum.UserInputType.Touch then

		local Delta = Input.Position - DragStart

		Button.Position = UDim2.new(
			StartPosition.X.Scale,
			StartPosition.X.Offset + Delta.X,

			StartPosition.Y.Scale,
			StartPosition.Y.Offset + Delta.Y
		)

	end

end)

UserInputService.InputEnded:Connect(function(Input)

	if Input.UserInputType == Enum.UserInputType.MouseButton1
		or Input.UserInputType == Enum.UserInputType.Touch then

		Dragging = false

	end

end)

--==================================================
-- ROOT DO JOGADOR
--==================================================

local function GetRoot()

	local Character = Player.Character

	if not Character then
		return nil
	end

	return Character:FindFirstChild("HumanoidRootPart")
end

--==================================================
-- POSIÇÃO REAL DO PROMPT
--==================================================

local function GetPromptPosition(Prompt)

	local Parent = Prompt.Parent

	if not Parent then
		return nil
	end

	-- Prompt diretamente dentro de uma Part
	if Parent:IsA("BasePart") then
		return Parent.Position
	end

	-- Prompt dentro de Attachment
	if Parent:IsA("Attachment") then
		return Parent.WorldPosition
	end

	-- Procura uma BasePart ancestral
	local Part = Prompt:FindFirstAncestorWhichIsA("BasePart")

	if Part then
		return Part.Position
	end

	return nil
end

--==================================================
-- RESTAURA PROMPT
--==================================================

local function RestorePrompt(Prompt)

	local Original = OriginalDuration[Prompt]

	if Original == nil then
		return
	end

	if Prompt.Parent then
		Prompt.HoldDuration = Original
	end

	OriginalDuration[Prompt] = nil

end

--==================================================
-- REMOVE DELAY
--==================================================

local function RemoveDelay(Prompt)

	if not Prompt:IsA("ProximityPrompt") then
		return
	end

	if not Prompt.Parent then
		OriginalDuration[Prompt] = nil
		return
	end

	-- Guarda o valor original somente na primeira vez
	if OriginalDuration[Prompt] == nil then
		OriginalDuration[Prompt] = Prompt.HoldDuration
	end

	-- Só escreve quando necessário
	if Prompt.HoldDuration ~= 0 then
		Prompt.HoldDuration = 0
	end

end

--==================================================
-- ATUALIZAR PROMPTS
--==================================================

local function UpdatePrompts()

	if not Enabled then
		return
	end

	local Root = GetRoot()

	if not Root then
		return
	end

	local PlayerPosition = Root.Position

	--================================================
	-- 1. VERIFICA OS QUE JÁ ESTÃO SENDO CONTROLADOS
	--================================================

	for Prompt in pairs(OriginalDuration) do

		if not Prompt.Parent then

			OriginalDuration[Prompt] = nil

		else

			local PromptPosition = GetPromptPosition(Prompt)

			if PromptPosition then

				local Offset = PromptPosition - PlayerPosition
				local DistanceSquared = Offset:Dot(Offset)

				-- Saiu dos 200 studs
				if DistanceSquared > RADIUS_SQUARED then
					RestorePrompt(Prompt)
				end

			else

				RestorePrompt(Prompt)

			end

		end

	end

	--================================================
	-- 2. PROCURA SOMENTE PARTES PRÓXIMAS
	--================================================

	local NearbyParts = workspace:GetPartBoundsInRadius(
		PlayerPosition,
		RADIUS
	)

	for _, Part in ipairs(NearbyParts) do

		-- Verifica a própria Part
		if Part:IsA("BasePart") then

			local DirectPrompt = Part:FindFirstChildOfClass("ProximityPrompt")

			if DirectPrompt then

				local PromptPosition = GetPromptPosition(DirectPrompt)

				if PromptPosition then

					local Offset = PromptPosition - PlayerPosition

					if Offset:Dot(Offset) <= RADIUS_SQUARED then
						RemoveDelay(DirectPrompt)
					end

				end

			end

		end

		-- Verifica prompts dentro de Attachments/objetos
		for _, Object in ipairs(Part:GetDescendants()) do

			if Object:IsA("ProximityPrompt") then

				local PromptPosition = GetPromptPosition(Object)

				if PromptPosition then

					local Offset = PromptPosition - PlayerPosition

					if Offset:Dot(Offset) <= RADIUS_SQUARED then
						RemoveDelay(Object)
					end

				end

			end

		end

	end

end

--==================================================
-- DESATIVAR
--==================================================

local function Disable()

	Enabled = false

	for Prompt, Original in pairs(OriginalDuration) do

		if Prompt.Parent then
			Prompt.HoldDuration = Original
		end

	end

	table.clear(OriginalDuration)

	Button.Text = "TIRAR DELAY"
	Button.BackgroundColor3 = Color3.fromRGB(12, 12, 12)
	Stroke.Color = Color3.fromRGB(45, 45, 45)

end

--==================================================
-- ATIVAR
--==================================================

local function Enable()

	Enabled = true

	Button.Text = "DELAY: ON"
	Button.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
	Stroke.Color = Color3.fromRGB(80, 80, 80)

	-- Faz uma atualização imediatamente
	UpdatePrompts()

end

--==================================================
-- BOTÃO
--==================================================

Button.Activated:Connect(function()

	if Enabled then
		Disable()
	else
		Enable()
	end

end)

--==================================================
-- LOOP OTIMIZADO
--==================================================

task.spawn(function()

	while ScreenGui.Parent do

		if Enabled then
			UpdatePrompts()
		end

		task.wait(CHECK_INTERVAL)

	end

end)

--==================================================
-- RESPAWN
--==================================================

Player.CharacterAdded:Connect(function()

	-- Os prompts continuam existindo no mapa,
	-- mas limpamos as referências antigas.
	table.clear(OriginalDuration)

end)
