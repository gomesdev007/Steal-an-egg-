--==================================================
-- TIRAR DELAY - MOBILE EXTREME LIGHT
--==================================================

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local Lighting = game:GetService("Lighting")

local Player = Players.LocalPlayer

local Enabled = false
local Processing = false

--==================================================
-- GUI
--==================================================

local Gui = Instance.new("ScreenGui")
Gui.Name = "TirarDelayMobile"
Gui.ResetOnSpawn = false
Gui.IgnoreGuiInset = true
Gui.Parent = Player:WaitForChild("PlayerGui")

local Button = Instance.new("TextButton")
Button.Size = UDim2.fromOffset(165, 48)
Button.Position = UDim2.new(0.5, -82, 0.5, -24)

Button.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
Button.BorderSizePixel = 0

Button.Text = "TIRAR DELAY: OFF"
Button.TextColor3 = Color3.new(1, 1, 1)
Button.TextSize = 14
Button.Font = Enum.Font.GothamBold

Button.Parent = Gui

local Corner = Instance.new("UICorner")
Corner.CornerRadius = UDim.new(0, 12)
Corner.Parent = Button

local Stroke = Instance.new("UIStroke")
Stroke.Color = Color3.fromRGB(60, 60, 60)
Stroke.Thickness = 1
Stroke.Parent = Button

--==================================================
-- DRAG
--==================================================

local Dragging = false
local DragStart
local StartPosition

Button.InputBegan:Connect(function(Input)

    if Input.UserInputType == Enum.UserInputType.Touch
        or Input.UserInputType == Enum.UserInputType.MouseButton1 then

        Dragging = true
        DragStart = Input.Position
        StartPosition = Button.Position
    end
end)

Button.InputEnded:Connect(function(Input)

    if Input.UserInputType == Enum.UserInputType.Touch
        or Input.UserInputType == Enum.UserInputType.MouseButton1 then

        Dragging = false
    end
end)

UserInputService.InputChanged:Connect(function(Input)

    if not Dragging then
        return
    end

    if Input.UserInputType == Enum.UserInputType.Touch
        or Input.UserInputType == Enum.UserInputType.MouseMovement then

        local Delta =
            Input.Position - DragStart

        Button.Position = UDim2.new(
            StartPosition.X.Scale,
            StartPosition.X.Offset + Delta.X,

            StartPosition.Y.Scale,
            StartPosition.Y.Offset + Delta.Y
        )
    end
end)

--==================================================
-- PROMPTS
--==================================================

local Prompts = {}

local function SetupPrompt(Object)

    if not Object:IsA("ProximityPrompt") then
        return
    end

    Prompts[Object] = true

    if Enabled then

        pcall(function()
            Object.HoldDuration = 0
        end)
    end
end

workspace.DescendantAdded:Connect(function(Object)

    if Object:IsA("ProximityPrompt") then
        SetupPrompt(Object)
    end
end)

workspace.DescendantRemoving:Connect(function(Object)

    if Object:IsA("ProximityPrompt") then
        Prompts[Object] = nil
    end
end)

--==================================================
-- EFEITOS
--==================================================

local Disabled = {}

local function DisableEffect(Object)

    if not Object.Enabled then
        return
    end

    Disabled[Object] = true

    pcall(function()
        Object.Enabled = false
    end)
end

local function Optimize(Object)

    if not Enabled then
        return
    end

    if Object:IsA("ParticleEmitter")
        or Object:IsA("Trail")
        or Object:IsA("Beam")
        or Object:IsA("Smoke")
        or Object:IsA("Fire")
        or Object:IsA("Sparkles")
        or Object:IsA("PointLight")
        or Object:IsA("SpotLight")
        or Object:IsA("SurfaceLight")
        or Object:IsA("BloomEffect")
        or Object:IsA("BlurEffect")
        or Object:IsA("ColorCorrectionEffect")
        or Object:IsA("DepthOfFieldEffect")
        or Object:IsA("SunRaysEffect") then

        DisableEffect(Object)
    end
end

--==================================================
-- OTIMIZAÇÃO SEM TRAVAMENTO
--==================================================

local function OptimizeCharacter()

    local Character = Player.Character

    if not Character then
        return
    end

    for _, Object in ipairs(Character:GetDescendants()) do

        if not Enabled then
            return
        end

        Optimize(Object)
    end
end

-- Novos efeitos são tratados individualmente.
game.DescendantAdded:Connect(function(Object)

    if not Enabled then
        return
    end

    if Object:IsA("ParticleEmitter")
        or Object:IsA("Trail")
        or Object:IsA("Beam")
        or Object:IsA("Smoke")
        or Object:IsA("Fire")
        or Object:IsA("Sparkles")
        or Object:IsA("PointLight")
        or Object:IsA("SpotLight")
        or Object:IsA("SurfaceLight") then

        task.defer(function()

            if Enabled and Object.Parent then
                Optimize(Object)
            end
        end)
    end
end)

--==================================================
-- LIGHTING
--==================================================

local OldShadows = Lighting.GlobalShadows
local OldDiffuse = Lighting.EnvironmentDiffuseScale
local OldSpecular = Lighting.EnvironmentSpecularScale

--==================================================
-- ATIVAR
--==================================================

local function Enable()

    if Enabled or Processing then
        return
    end

    Enabled = true
    Processing = true

    Button.Text = "TIRAR DELAY: ON"

    -- Prompts conhecidos.
    for Prompt in pairs(Prompts) do

        if Prompt and Prompt.Parent then

            pcall(function()
                Prompt.HoldDuration = 0
            end)
        end
    end

    -- Lighting é instantâneo e leve.
    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0
    end)

    -- Só personagem local, evitando varrer o jogo inteiro.
    task.spawn(function()

        OptimizeCharacter()

        Processing = false
    end)
end

--==================================================
-- DESATIVAR
--==================================================

local function Disable()

    if Processing then
        return
    end

    Enabled = false

    Button.Text = "TIRAR DELAY: OFF"

    -- Restaura efeitos.
    for Object in pairs(Disabled) do

        if Object and Object.Parent then

            pcall(function()
                Object.Enabled = true
            end)
        end
    end

    table.clear(Disabled)

    -- Restaura iluminação.
    pcall(function()
        Lighting.GlobalShadows = OldShadows
        Lighting.EnvironmentDiffuseScale = OldDiffuse
        Lighting.EnvironmentSpecularScale = OldSpecular
    end)
end

--==================================================
-- BOTÃO
--==================================================

Button.Activated:Connect(function()

    if Enabled then
        Disable()
    else
        Enable()
    end
end)

--==================================================
-- RESPAWN
--==================================================

Player.CharacterAdded:Connect(function(Character)

    if not Enabled then
        return
    end

    task.wait(0.5)

    if Enabled then
        OptimizeCharacter()
    end
end)
