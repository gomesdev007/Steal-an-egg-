--==================================================
-- CHARACTER
--==================================================

local function getCharacter()

    local character = player.Character

    if not character then
        return
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if humanoid and root then
        return character, humanoid, root
    end
end

--==================================================
-- STOP WALK/RUN ANIMATIONS
--==================================================

local function stopWalkAnimations(humanoid)

    local animator = humanoid:FindFirstChildOfClass("Animator")

    if not animator then
        return
    end

    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do

        local name = string.lower(track.Name)

        if name == "walk"
            or name == "walkanim"
            or name == "run"
            or name == "runanim"
            or string.find(name, "walk")
            or string.find(name, "run") then

            track:Stop(0)
        end
    end
end

--==================================================
-- REMOVE ORIENTATION
--==================================================

local function removeOrientation()

    if align then
        align:Destroy()
        align = nil
    end

    if attachment then
        attachment:Destroy()
        attachment = nil
    end

    local _, humanoid = getCharacter()

    if humanoid then
        humanoid.AutoRotate = true
    end
end

--==================================================
-- STOP AUTO STEAL
--==================================================

local function stopAutoSteal()

    if not ativo then
        enableControls()
        return
    end

    ativo = false

    movimentoToken += 1

    enableControls()

    local _, humanoid, root = getCharacter()

    if humanoid and root then

        humanoid:Move(Vector3.zero, true)
        humanoid:MoveTo(root.Position)

        humanoid.AutoRotate = true
        humanoid.Jump = false
    end

    removeOrientation()

    button.Text = "START"
    button.BackgroundColor3 = Color3.fromRGB(30, 30, 35)

    status.Text = "MANUAL • OFF"
    status.TextColor3 = Color3.fromRGB(145, 145, 150)
end

--==================================================
-- START AUTO STEAL
--==================================================

local function startAutoSteal()

    removeOrientation()

    local character, humanoid, root = getCharacter()

    if not character or not humanoid or not root then

        ativo = false
        enableControls()

        button.Text = "START"
        button.BackgroundColor3 = Color3.fromRGB(30, 30, 35)

        status.Text = "MANUAL • OFF"
        status.TextColor3 = Color3.fromRGB(145, 145, 150)

        return
    end

    -- Block player controls
    blockControls()

    humanoid.AutoRotate = false
    humanoid.Jump = false

    --==================================================
    -- ORIENTATION
    --==================================================

    attachment = Instance.new("Attachment")
    attachment.Name = "AutoStealAttachment"
    attachment.Parent = root

    align = Instance.new("AlignOrientation")
    align.Name = "AutoStealOrientation"
    align.Mode = Enum.OrientationAlignmentMode.OneAttachment
    align.Attachment0 = attachment
    align.RigidityEnabled = true
    align.Responsiveness = 200
    align.MaxTorque = math.huge
    align.Parent = root

    local forward = root.CFrame.LookVector

    local left = Vector3.new(
        forward.Z,
        0,
        -forward.X
    )

    if left.Magnitude > 0 then

        left = left.Unit

        align.CFrame = CFrame.lookAt(
            Vector3.zero,
            left
        )
    end

    --==================================================
    -- MOVEMENT TOKEN
    --==================================================

    movimentoToken += 1

    local myToken = movimentoToken

    --==================================================
    -- MOVEMENT
    --==================================================

    task.spawn(function()

        while ativo
            and myToken == movimentoToken
            and humanoid.Parent
            and root.Parent do

            humanoid.Jump = false

            blockControls()

            stopWalkAnimations(humanoid)

            local distance = (root.Position - POS2).Magnitude

            -- Reached destination
            if distance <= 3 then

                humanoid:Move(Vector3.zero, true)

                stopAutoSteal()

                break
            end

            -- Script movement only
            humanoid:MoveTo(POS2)

            task.wait(0.15)
        end

        if not ativo and humanoid.Parent then
            humanoid:Move(Vector3.zero, true)
        end

    end)
end

