--==================================================
-- GET CHARACTER
--==================================================

local function pegar()

    local character = player.Character

    if not character then
        return
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if humanoid and root then
        return character, humanoid, root
    end

end

--==================================================
-- STOP WALK/RUN ANIMATIONS
--==================================================

local function pararCaminhada(humanoid)

    local animator = humanoid:FindFirstChildOfClass("Animator")

    if not animator then
        return
    end

    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do

        local nome = string.lower(track.Name)

        if nome == "walk"
            or nome == "walkanim"
            or nome == "run"
            or nome == "runanim"
            or string.find(nome, "walk")
            or string.find(nome, "run") then

            track:Stop(0)

        end

    end

end

--==================================================
-- REMOVE ORIENTATION
--==================================================

local function removerOrientacao()

    if align then
        align:Destroy()
        align = nil
    end

    if attachment then
        attachment:Destroy()
        attachment = nil
    end

    local _, humanoid = pegar()

    if humanoid then
        humanoid.AutoRotate = true
    end

end

--==================================================
-- DISABLE CONTROLS
--==================================================

local function bloquearControles()

    local controls = obterControles()

    if controls then
        controls:Disable()
    end

end

--==================================================
-- ENABLE CONTROLS
--==================================================

local function liberarControles()

    local controls = obterControles()

    if controls then
        controls:Enable()
    end

end

--==================================================
-- DISABLE AUTO STEAL MANUAL
--==================================================

local function desativar()

    if not ativo then
        liberarControles()
        return
    end

    ativo = false

    movimentoToken += 1

    liberarControles()

    local character, humanoid, root = pegar()

    if humanoid and root then

        humanoid:Move(Vector3.zero, true)
        humanoid:MoveTo(root.Position)

        humanoid.AutoRotate = true
        humanoid.Jump = false

    end

    removerOrientacao()

    button.Text = "ENABLE"
    button.BackgroundColor3 = Color3.fromRGB(30, 30, 35)

    status.Text = "● INACTIVE"
    status.TextColor3 = Color3.fromRGB(145, 145, 150)

end

--==================================================
-- ENABLE AUTO STEAL MANUAL
--==================================================

local function iniciar()

    removerOrientacao()

    local character, humanoid, root = pegar()

    if not character or not humanoid or not root then

        ativo = false
        liberarControles()

        button.Text = "ENABLE"
        button.BackgroundColor3 = Color3.fromRGB(30, 30, 35)

        status.Text = "● INACTIVE"
        status.TextColor3 = Color3.fromRGB(145, 145, 150)

        return

    end

    -- Disable manual movement
    bloquearControles()

    humanoid.AutoRotate = false
    humanoid.Jump = false

    --==================================================
    -- ORIENTATION
    --==================================================

    attachment = Instance.new("Attachment")
    attachment.Name = "AutoStealDirectionAttachment"
    attachment.Parent = root

    align = Instance.new("AlignOrientation")
    align.Name = "ForceAutoStealDirection"
    align.Mode = Enum.OrientationAlignmentMode.OneAttachment
    align.Attachment0 = attachment
    align.RigidityEnabled = true
    align.Responsiveness = 200
    align.MaxTorque = math.huge
    align.Parent = root

    local forward = root.CFrame.LookVector

    local left = Vector3.new(
        forward.Z,
        0,
        -forward.X
    )

    if left.Magnitude > 0 then

        left = left.Unit

        align.CFrame = CFrame.lookAt(
            Vector3.zero,
            left
        )

    end

    --==================================================
    -- TOKEN
    --==================================================

    movimentoToken += 1

    local meuToken = movimentoToken

    --==================================================
    -- MOVEMENT
    --==================================================

    task.spawn(function()

        while ativo
            and meuToken == movimentoToken
            and humanoid.Parent
            and root.Parent do

            -- Prevent jumping
            humanoid.Jump = false

            -- Keep manual controls disabled
            bloquearControles()

            -- Keep Walk/Run animations stopped
            pararCaminhada(humanoid)

            local distancia = (root.Position - POS2).Magnitude

            --==================================================
            -- ARRIVED
            --==================================================

            if distancia <= 3 then

                humanoid:Move(Vector3.zero, true)

                desativar()

                break

            end

            --==================================================
            -- AUTO MOVEMENT
            --==================================================

            humanoid:MoveTo(POS2)

            task.wait(0.15)

        end

        if not ativo and humanoid.Parent then
            humanoid:Move(Vector3.zero, true)
        end

    end)

end

