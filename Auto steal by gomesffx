--==================================================
-- PROMPT TRIGGER
--==================================================

ProximityPromptService.PromptTriggered:Connect(function(prompt, triggeredPlayer)

    if triggeredPlayer ~= player then
        return
    end

    if not autoSteal then
        return
    end

    if ativo then
        return
    end

    ativo = true

    button.Text = "STOP"
    button.BackgroundColor3 = Color3.fromRGB(38, 90, 52)

    status.Text = "MANUAL • ON"
    status.TextColor3 = Color3.fromRGB(90, 220, 115)

    startAutoSteal()
end)

--==================================================
-- RESPAWN
--==================================================

player.CharacterAdded:Connect(function()

    enableControls()

    if align then
        align:Destroy()
        align = nil
    end

    if attachment then
        attachment:Destroy()
        attachment = nil
    end

    movimentoToken += 1

    if ativo then

        task.wait(1)

        if ativo then
            startAutoSteal()
        end
    end
end)
