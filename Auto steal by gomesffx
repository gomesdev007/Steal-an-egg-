        status.Text = "● ACTIVE"
        status.TextColor3 = Color3.fromRGB(90, 220, 115)

    end

end

--==================================================
-- STOP AUTO STEAL
--==================================================

local function pararAutoSteal()

    if autoStealConnection then
        autoStealConnection:Disconnect()
        autoStealConnection = nil
    end

    if promptCheckConnection then
        promptCheckConnection:Disconnect()
        promptCheckConnection = nil
    end

    restaurarPrompts()

end

--==================================================
-- DISABLE
--==================================================

local function desativar()

    ativo = false

    movimentoToken += 1

    liberarControles()

    local character, humanoid, root = pegar()

    if humanoid and root then

        humanoid:Move(Vector3.zero, true)
        humanoid:MoveTo(root.Position)

        humanoid.AutoRotate = true
        humanoid.Jump = false

    end

    removerOrientacao()

    atualizarUI(true)

end

--==================================================
-- MOVEMENT INTERRUPTION
--==================================================

local function movimentoInterrompido(humanoid)

    if not humanoid or not humanoid.Parent then
        return true
    end

    local state = humanoid:GetState()

    if state == Enum.HumanoidStateType.Ragdoll
        or state == Enum.HumanoidStateType.FallingDown
        or state == Enum.HumanoidStateType.Physics
        or state == Enum.HumanoidStateType.PlatformStanding
        or state == Enum.HumanoidStateType.Seated
        or state == Enum.HumanoidStateType.Dead then

        return true
    end

    return false
end

--==================================================
-- START MOVEMENT
--==================================================

local function iniciar()

    local character, humanoid, root = pegar()

    if not character or not humanoid or not root then

        ativo = false
        liberarControles()
        atualizarUI(true)

        return

    end

    removerOrientacao()

    bloquearControles()

    humanoid.AutoRotate = false
    humanoid.Jump = false

    attachment = Instance.new("Attachment")
    attachment.Name = "AutoStealDirectionAttachment"
    attachment.Parent = root

    align = Instance.new("AlignOrientation")
    align.Name = "ForceAutoStealDirection"
    align.Mode = Enum.OrientationAlignmentMode.OneAttachment
    align.Attachment0 = attachment
    align.RigidityEnabled = true
    align.Responsiveness = 200
    align.MaxTorque = math.huge
    align.Parent = root

    local forward = root.CFrame.LookVector

    local left = Vector3.new(
        forward.Z,
        0,
        -forward.X
    )

    if left.Magnitude > 0 then

        left = left.Unit

        align.CFrame = CFrame.lookAt(
            Vector3.zero,
            left
        )

    end

    movimentoToken += 1

    local meuToken = movimentoToken

    task.spawn(function()

        while true do

            if not ativo then
                break
            end

            if meuToken ~= movimentoToken then
                break
            end

            if not humanoid.Parent or not root.Parent then
                break
            end

            if movimentoInterrompido(humanoid) then

                humanoid:Move(Vector3.zero, true)
                humanoid.Jump = false

                movimentoToken += 1

                removerOrientacao()
                liberarControles()

                break
            end

            humanoid.Jump = false

            pararCaminhada(humanoid)

            local distancia = (root.Position - POS2).Magnitude

            if distancia <= 3 then

                humanoid:Move(Vector3.zero, true)

                desativar()

                break

            end

            if not controlsDisabled then
                bloquearControles()
            end

            humanoid:MoveTo(POS2)

            task.wait(0.15)

        end

        if not ativo and humanoid.Parent then

            humanoid:Move(Vector3.zero, true)
            humanoid.Jump = false

        end

    end)

end

