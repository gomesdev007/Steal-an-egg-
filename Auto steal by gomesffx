--==================================================
-- AUTO STEAL → PROXIMITY PROMPT
--==================================================

ProximityPromptService.PromptTriggered:Connect(function(prompt, triggeredPlayer)

    -- Only react to the local player
    if triggeredPlayer ~= player then
        return
    end

    -- Auto Steal must be enabled
    if not autoLeft then
        return
    end

    -- Don't restart if already active
    if ativo then
        return
    end

    -- Start automatically
    ativo = true

    button.Text = "DISABLE"
    button.BackgroundColor3 = Color3.fromRGB(38, 90, 52)

    status.Text = "● ACTIVE"
    status.TextColor3 = Color3.fromRGB(90, 220, 115)

    iniciar()

end)

--==================================================
-- RESPAWN
--==================================================

player.CharacterAdded:Connect(function(character)

    liberarControles()

    if align then
        align:Destroy()
        align = nil
    end

    if attachment then
        attachment:Destroy()
        attachment = nil
    end

    movimentoToken += 1

    if ativo then

        task.wait(1)

        if ativo then
            iniciar()
        end

    end

end)
